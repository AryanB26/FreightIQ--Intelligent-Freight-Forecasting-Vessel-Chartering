# FreightIQ Environment Configuration
# Copy to .env.local and fill in values

# Database
DATABASE_URL=

# Data Provider Mode (demo or real)
DATA_PROVIDER_MODE=demo

# API Keys (server-side only — never commit real keys)
FREIGHT_API_KEY=
VESSEL_API_KEY=
WEATHER_API_KEY=
PORT_API_KEY=

# Forecast API
FORECAST_API_URL=http://localhost:8000
FORECAST_API_KEY=

# App
NEXT_PUBLIC_APP_ENV=development
